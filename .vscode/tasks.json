{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build ledgerd",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "ledgerd"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "cargo: build ledgerfio",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "ledgerfio"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "cargo: build ledgersim",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "ledgersim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "cargo: test",
      "type": "shell",
      "command": "cargo",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "test"
    },
    {
      "label": "cargo: run ledgerd",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "ledgerd",
        "--",
        "--accounts",
        "1000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "cargo: run ledgerfio",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "ledgerfio",
        "--",
        "run",
        "--workload",
        "hold-settle",
        "--duration",
        "3s",
        "--accounts",
        "100000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "cargo: run ledgersim",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "ledgersim",
        "--",
        "check",
        "--seeds",
        "16"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "test"
    },
    {
      "label": "run: fio hold-settle",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "ledgerfio",
        "--",
        "run",
        "--workload",
        "hold-settle",
        "--duration",
        "3s",
        "--accounts",
        "100000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "run: sim check",
      "type": "shell",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "ledgersim",
        "--",
        "check",
        "--seeds",
        "16"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "test"
    }
  ]
}
